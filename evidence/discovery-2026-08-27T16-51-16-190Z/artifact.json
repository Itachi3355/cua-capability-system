{
  "schemaVersion": 1,
  "id": "41ad6127-5da0-4f23-9873-af56f95c29a3",
  "name": "lookup_member_savings_balance",
  "description": "Looks up a member by their member number ({{member_id}}) in the Meridian CU Teller Console and reports their current savings account balance.",
  "version": 1,
  "createdAt": "2026-08-27T16:51:40.938Z",
  "approval": "draft",
  "app": {
    "label": "Meridian CU Teller Console",
    "baseUrl": "http://localhost:4173"
  },
  "params": [
    {
      "name": "member_id",
      "type": "string",
      "description": "The member number to look up",
      "required": true,
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "savings_balance",
      "type": "string",
      "description": "Current savings account balance for member {{member_id}} (Margaret Chen)"
    }
  ],
  "steps": [
    {
      "id": "s0",
      "intent": "Open the application entry point",
      "timeoutMs": 10000,
      "action": "navigate",
      "url": "http://localhost:4173"
    },
    {
      "id": "s1",
      "intent": "Go to Member Search page",
      "expect": {
        "urlContains": "/members"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Member Search",
        "nearText": "|"
      },
      "risky": false
    },
    {
      "id": "s2",
      "intent": "Enter member number",
      "timeoutMs": 10000,
      "action": "type",
      "target": {
        "role": "textbox",
        "name": "q",
        "nearText": "Member # or Name:",
        "structuralPath": "html>body>table>tbody>tr:2>td>form>table>tbody>tr>td:1>input"
      },
      "value": "{{member_id}}",
      "sensitive": false
    },
    {
      "id": "s3",
      "intent": "Search for member",
      "expect": {
        "urlContains": "/members?q={{member_id}}"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search",
        "nearText": "Member # or Name:"
      },
      "risky": false
    },
    {
      "id": "s4",
      "intent": "Open member detail page",
      "expect": {
        "urlContains": "/members/{{member_id}}"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Margaret Chen",
        "nearText": "{{member_id}}"
      },
      "risky": false
    },
    {
      "id": "s6",
      "intent": "Narrow extraction to just the balance value",
      "timeoutMs": 10000,
      "action": "extract",
      "anchor": "Savings",
      "cellIndex": 1,
      "output": "savings_balance"
    }
  ],
  "outcomes": [
    {
      "code": "member_not_found",
      "description": "The search for the specified member number or name returned no matching records in the credit union system.",
      "source": "observed",
      "when": {
        "textVisible": "Verify the member number and try again."
      }
    },
    {
      "code": "invalid_search_input",
      "description": "Search input was empty or invalid",
      "source": "proposed",
      "when": {
        "textVisible": "Please enter a member number or name"
      }
    },
    {
      "code": "account_restricted",
      "description": "Member account is restricted or flagged and details cannot be shown",
      "source": "proposed",
      "when": {
        "textVisible": "Account restricted"
      }
    }
  ],
  "recoveries": [
    {
      "id": "session_expired",
      "description": "Session expired interstitial requires re-login to resume",
      "when": {
        "textVisible": "Session expired"
      },
      "do": {
        "click": {
          "role": "button",
          "name": "Log In"
        }
      },
      "maxAttempts": 1
    },
    {
      "id": "confirm_dialog",
      "description": "Generic confirmation dialog blocking navigation",
      "when": {
        "textVisible": "Are you sure you want to continue?"
      },
      "do": {
        "click": {
          "role": "button",
          "name": "OK"
        }
      },
      "maxAttempts": 1
    }
  ],
  "success": {
    "urlContains": "/members/{{member_id}}",
    "textVisible": "Member #: {{member_id}}"
  },
  "provenance": {
    "discoveryRunId": "discovery-2026-08-27T16-51-16-190Z",
    "model": "claude-sonnet-5",
    "goal": "Look up the member by their member number and report their current savings account balance"
  }
}