{
  "schemaVersion": 1,
  "id": "d778974f-e2f1-4420-aff3-203a397dff65",
  "name": "lookup_member_savings_balance",
  "description": "Look up a member by member number ({{member_id}}) and report their current savings account balance",
  "version": 1,
  "createdAt": "2026-08-27T16:39:22.027Z",
  "approval": "draft",
  "app": {
    "label": "Meridian CU Teller Console",
    "baseUrl": "http://localhost:4173"
  },
  "params": [
    {
      "name": "member_id",
      "type": "string",
      "description": "The member number to look up",
      "required": true,
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "savings_balance",
      "type": "string",
      "description": "Current savings account balance for member {{member_id}}"
    }
  ],
  "steps": [
    {
      "id": "s0",
      "intent": "Open the application entry point",
      "timeoutMs": 10000,
      "action": "navigate",
      "url": "http://localhost:4173"
    },
    {
      "id": "s1",
      "intent": "Go to Member Search page",
      "expect": {
        "urlContains": "/members"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Member Search",
        "nearText": "»"
      },
      "risky": false
    },
    {
      "id": "s2",
      "intent": "Enter member number to search",
      "timeoutMs": 10000,
      "action": "type",
      "target": {
        "role": "textbox",
        "name": "q",
        "nearText": "Member # or Name:",
        "structuralPath": "html>body>table>tbody>tr:2>td>form>table>tbody>tr>td:1>input"
      },
      "value": "{{member_id}}",
      "sensitive": false
    },
    {
      "id": "s3",
      "intent": "Search for member",
      "expect": {
        "urlContains": "/members?q={{member_id}}"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search",
        "nearText": "Member # or Name:"
      },
      "risky": false
    },
    {
      "id": "s4",
      "intent": "Open member detail page for Margaret Chen",
      "expect": {
        "urlContains": "/members/{{member_id}}"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Margaret Chen",
        "nearText": "{{member_id}}"
      },
      "risky": false
    },
    {
      "id": "s6",
      "intent": "Extract just the balance value for savings account",
      "timeoutMs": 10000,
      "action": "extract",
      "anchor": "Savings",
      "cellIndex": 1,
      "output": "savings_balance"
    }
  ],
  "outcomes": [
    {
      "code": "member_not_found",
      "description": "No member matches the given member number or name",
      "when": {
        "textVisible": "No members found"
      }
    },
    {
      "code": "invalid_search_input",
      "description": "Search was submitted without a valid member number or name",
      "when": {
        "textVisible": "Please enter a member number or name"
      }
    },
    {
      "code": "account_closed",
      "description": "Member account is closed or inactive",
      "when": {
        "textVisible": "Account Closed"
      }
    }
  ],
  "recoveries": [
    {
      "id": "session_expired",
      "description": "Session expired interstitial requires re-login to resume",
      "when": {
        "textVisible": "Session Expired"
      },
      "do": {
        "click": {
          "role": "button",
          "name": "Log In"
        }
      },
      "maxAttempts": 1
    },
    {
      "id": "session_timeout_continue",
      "description": "Idle timeout warning dialog with continue option",
      "when": {
        "textVisible": "Your session has timed out"
      },
      "do": {
        "click": {
          "role": "button",
          "name": "Continue"
        }
      },
      "maxAttempts": 1
    }
  ],
  "success": {
    "urlContains": "/members/{{member_id}}",
    "textVisible": "Savings"
  },
  "provenance": {
    "discoveryRunId": "discovery-2026-08-27T16-38-55-993Z",
    "model": "claude-sonnet-5",
    "goal": "Look up the member by their member number and report their current savings account balance"
  }
}