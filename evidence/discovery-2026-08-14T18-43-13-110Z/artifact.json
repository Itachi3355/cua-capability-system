        "nearText": "Product:",
        "structuralPath": "html>body>table>tbody>tr:2>td>form>table>tbody>tr:0>td:1>select"
      },
      "value": "Money Market"
    },
    {
      "id": "s7",
      "intent": "Enter account nickname",
      "timeoutMs": 10000,
      "action": "type",
      "target": {
        "role": "textbox",
        "name": "nick",
        "nearText": "Account Nickname:",
        "structuralPath": "html>body>table>tbody>tr:2>td>form>table>tbody>tr:1>td:1>input"
      },
      "value": "Vacation Fund",
      "sensitive": false
    },
    {
      "id": "s8",
      "intent": "Continue to confirmation screen",
      "expect": {
        "urlContains": "/members/{{member_id}}/subaccount/review"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "button",
        "name": "Continue »",
        "nearText": "Account Nickname:",
        "structuralPath": "html>body>table>tbody>tr:2>td>form>table>tbody>tr:2>td:1>input"
      },
      "risky": false
    },
    {
      "id": "s9",
      "intent": "Confirm and open the sub-account",
      "expect": {
        "urlContains": "/members/{{member_id}}/subaccount/create"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "button",
        "name": "Confirm and Open Account",
        "nearText": "Confirming will open a live sub-account on the member's record.",
        "structuralPath": "html>body>table>tbody>tr:2>td>form>input:2"
      },
      "risky": true
    }
