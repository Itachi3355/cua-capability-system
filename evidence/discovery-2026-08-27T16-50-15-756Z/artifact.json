{
  "schemaVersion": 1,
  "id": "1e3b58d8-8324-4ecd-a824-fbed7278cb0f",
  "name": "lookup_member_savings_balance",
  "description": "Look up a member by their member number in the Teller Console and report their current savings account balance.",
  "version": 1,
  "createdAt": "2026-08-27T16:50:37.486Z",
  "approval": "draft",
  "app": {
    "label": "Meridian CU Teller Console",
    "baseUrl": "http://localhost:4173"
  },
  "params": [
    {
      "name": "member_id",
      "type": "string",
      "description": "The member number to look up",
      "required": true,
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "savings_balance",
      "type": "string",
      "description": "Current savings account balance for member {{member_id}}"
    }
  ],
  "steps": [
    {
      "id": "s0",
      "intent": "Open the application entry point",
      "timeoutMs": 10000,
      "action": "navigate",
      "url": "http://localhost:4173"
    },
    {
      "id": "s1",
      "intent": "Go to Member Search page",
      "expect": {
        "urlContains": "/members"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Member Search",
        "nearText": "|"
      },
      "risky": false
    },
    {
      "id": "s2",
      "intent": "Enter member number to search",
      "timeoutMs": 10000,
      "action": "type",
      "target": {
        "role": "textbox",
        "name": "q",
        "nearText": "Member # or Name:",
        "structuralPath": "html>body>table>tbody>tr:2>td>form>table>tbody>tr>td:1>input"
      },
      "value": "{{member_id}}",
      "sensitive": false
    },
    {
      "id": "s3",
      "intent": "Search for member {{member_id}}",
      "expect": {
        "urlContains": "/members?q={{member_id}}"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search",
        "nearText": "Member # or Name:"
      },
      "risky": false
    },
    {
      "id": "s4",
      "intent": "Open Margaret Chen's member detail page",
      "expect": {
        "urlContains": "/members/{{member_id}}"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Margaret Chen",
        "nearText": "{{member_id}}"
      },
      "risky": false
    },
    {
      "id": "s5",
      "intent": "Extract the savings account balance value",
      "timeoutMs": 10000,
      "action": "extract",
      "anchor": "Savings",
      "output": "savings_balance"
    }
  ],
  "outcomes": [
    {
      "code": "member_not_found",
      "description": "The search for a member using the provided member number or name returned no matching records.",
      "source": "observed",
      "when": {
        "textVisible": "Verify the member number and try again."
      }
    },
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "Search returns no matching member record",
      "source": "proposed",
      "when": {
        "textVisible": "No members found"
      }
    },
    {
      "code": "INVALID_MEMBER_NUMBER",
      "description": "Input validation error for malformed member number",
      "source": "proposed",
      "when": {
        "textVisible": "Invalid member number"
      }
    },
    {
      "code": "NO_SAVINGS_ACCOUNT",
      "description": "Member record exists but has no savings account",
      "source": "proposed",
      "when": {
        "textVisible": "No savings account on file"
      }
    },
    {
      "code": "ACCOUNT_RESTRICTED",
      "description": "Member account is flagged or restricted from view",
      "source": "proposed",
      "when": {
        "textVisible": "Account restricted"
      }
    }
  ],
  "recoveries": [
    {
      "id": "SESSION_EXPIRED",
      "description": "Session expired interstitial requiring re-login",
      "when": {
        "textVisible": "Session expired"
      },
      "do": {
        "click": {
          "role": "button",
          "name": "Log In"
        }
      },
      "maxAttempts": 1
    },
    {
      "id": "SECURITY_TIMEOUT_CONTINUE",
      "description": "Idle timeout warning dialog with continue option",
      "when": {
        "textVisible": "Your session is about to expire"
      },
      "do": {
        "click": {
          "role": "button",
          "name": "Continue"
        }
      },
      "maxAttempts": 1
    }
  ],
  "success": {
    "urlContains": "/members/{{member_id}}",
    "textVisible": "Savings"
  },
  "provenance": {
    "discoveryRunId": "discovery-2026-08-27T16-50-15-756Z",
    "model": "claude-sonnet-5",
    "goal": "Look up the member by their member number and report their current savings account balance"
  }
}