{
  "schemaVersion": 1,
  "id": "106bde02-1cf1-4c60-9aaa-74a0cb2141f7",
  "name": "open_money_market_subaccount",
  "description": "Opens a new Money Market sub-account for a given member with a specified nickname, completes the confirmation flow, and reports the new account's reference number.",
  "version": 1,
  "createdAt": "2026-09-24T16:51:21.337Z",
  "approval": "approved",
  "app": {
    "label": "Meridian CU Teller Console",
    "baseUrl": "http://localhost:4173"
  },
  "params": [
    {
      "name": "member_id",
      "type": "string",
      "description": "The member number",
      "required": true,
      "sensitive": false
    },
    {
      "name": "nickname",
      "type": "string",
      "description": "Nickname for the new sub-account",
      "required": true,
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "new_subaccount_reference_number",
      "type": "string",
      "description": "Reference number of the newly opened Money Market sub-account"
    }
  ],
  "steps": [
    {
      "id": "s0",
      "intent": "Open the application entry point",
      "timeoutMs": 10000,
      "action": "navigate",
      "url": "http://localhost:4173"
    },
    {
      "id": "s1",
      "intent": "Go to Member Search",
      "expect": {
        "urlContains": "/members"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Member Search",
        "nearText": "»"
      },
      "risky": false
    },
    {
      "id": "s2",
      "intent": "Enter member ID to search",
      "timeoutMs": 10000,
      "action": "type",
      "target": {
        "role": "textbox",
        "name": "q",
        "nearText": "Member # or Name:",
        "structuralPath": "html>body>table>tbody>tr:2>td>form>table>tbody>tr>td:1>input"
      },
      "value": "{{member_id}}",
      "sensitive": false
    },
    {
      "id": "s3",
      "intent": "Search for member",
      "expect": {
        "urlContains": "/members?q={{member_id}}"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search",
        "nearText": "Member # or Name:"
      },
      "risky": false
    },
    {
      "id": "s4",
      "intent": "Open member record",
      "expect": {
        "urlContains": "/members/{{member_id}}"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Margaret Chen",
        "nearText": "{{member_id}}"
      },
      "risky": false
    },
    {
      "id": "s5",
      "intent": "Open sub-account creation form",
      "expect": {
        "urlContains": "/members/{{member_id}}/subaccount/new"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Open Sub-Account",
        "nearText": "»"
      },
      "risky": false
    },
    {
      "id": "s6",
      "intent": "Select Money Market product type",
      "timeoutMs": 10000,
      "action": "select",
      "target": {
        "role": "select",
        "name": "ptype",
        "nearText": "Product:"
      },
      "value": "Money Market"
    },
    {
      "id": "s7",
      "intent": "Enter nickname for new sub-account",
      "timeoutMs": 10000,
      "action": "type",
      "target": {
        "role": "textbox",
        "name": "nick",
        "nearText": "Account Nickname:"
      },
      "value": "{{nickname}}",
      "sensitive": false
    },
    {
      "id": "s8",
      "intent": "Continue to next step",
      "expect": {
        "urlContains": "/members/{{member_id}}/subaccount/review"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "button",
        "name": "Continue »",
        "nearText": "Account Nickname:"
      },
      "risky": false
    },
    {
      "id": "s9",
      "intent": "Confirm opening of the new sub-account",
      "expect": {
        "urlContains": "/members/{{member_id}}/subaccount/create"
      },
      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "button",
        "name": "Confirm and Open Account",
        "nearText": "Confirming will open a live sub-account on the member's record."
      },
      "risky": true
    },
    {
      "id": "s10",
      "intent": "Extract the reference number for the new sub-account",
      "timeoutMs": 10000,
      "action": "extract",
      "anchor": "Sub-account opened successfully.",
      "output": "new_subaccount_reference_number"
    }
  ],
  "outcomes": [
    {
      "code": "member_not_found",
      "description": "Member search returned no matching record",
      "source": "proposed",
      "when": {
        "textVisible": "No members found"
      }
    },
    {
      "code": "invalid_member_id",
      "description": "Search input was invalid or malformed",
      "source": "proposed",
      "when": {
        "textVisible": "Invalid member number"
      }
    },
    {
      "code": "nickname_required",
      "description": "Sub-account nickname field was left blank",
      "source": "proposed",
      "when": {
        "textVisible": "Nickname is required"
      }
    },
    {
      "code": "duplicate_nickname",
      "description": "A sub-account with this nickname already exists for the member",
      "source": "proposed",
      "when": {
        "textVisible": "already exists"
      }
    },
    {
      "code": "account_limit_reached",
      "description": "Member has reached the maximum number of sub-accounts allowed",
      "source": "proposed",
      "when": {
        "textVisible": "maximum number of sub-accounts"
      }
    },
    {
      "code": "product_unavailable",
      "description": "Selected product type is not available for this member",
      "source": "proposed",
      "when": {
        "textVisible": "not available for this member"
      }
    },
    {
      "code": "creation_failed",
      "description": "Sub-account creation failed on confirmation",
      "source": "proposed",
      "when": {
        "textVisible": "Unable to open sub-account"
      }
    }
  ],
  "recoveries": [
    {
      "id": "session_expired",
      "description": "Session expired interstitial; re-login to resume",
      "when": {
        "textVisible": "Your session has expired"
      },
      "do": {
        "click": {
          "role": "button",
          "name": "Log In"
        }
      },
      "maxAttempts": 1
    },
    {
      "id": "session_timeout_continue",
      "description": "Idle timeout warning page with continue option",
      "when": {
        "textVisible": "session is about to expire"
      },
      "do": {
        "click": {
          "role": "button",
          "name": "Continue Session"
        }
      },
      "maxAttempts": 1
    },
    {
      "id": "transient_error_retry",
      "description": "Generic transient error page with retry button",
      "when": {
        "textVisible": "Something went wrong"
      },
      "do": {
        "click": {
          "role": "button",
          "name": "Retry"
        }
      },
      "maxAttempts": 1
    }
  ],
  "success": {
    "urlContains": "/members/{{member_id}}/subaccount/create",
    "textVisible": "Sub-account opened successfully."
  },
  "provenance": {
    "discoveryRunId": "discovery-2026-09-24T16-50-34-411Z",
    "model": "claude-sonnet-5",
    "goal": "Open a new Money Market sub-account for the member using the given nickname, reach the confirmation screen, and report the new account's reference number"
  }
}