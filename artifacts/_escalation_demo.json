{
  "schemaVersion": 1,
  "id": "bb7cad56-232c-409a-9cfb-d5c4f9a929b9",
  "name": "lookup_member_savings_balance",
  "description": "Look up a member by member number ({{member_id}}) and report their current savings account balance. [DEMO COPY: s3 target fully sabotaged to force human escalation]",
