        "role": "link",
        "name": "Member Search",
        "nearText": "|",
        "structuralPath": "html>body>table>tbody>tr:1>td>table>tbody>tr>td:2>a"
      },
      "risky": false
    },
    {
      "id": "s2",
      "intent": "Enter member number to search",
      "timeoutMs": 10000,
      "action": "type",
