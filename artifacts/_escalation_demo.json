      "timeoutMs": 10000,
      "action": "click",
      "target": {
        "role": "link",
        "name": "Margaret Chen",
        "nearText": "{{member_id}}",
        "structuralPath": "html>body>table>tbody>tr:2>td>table>tbody>tr:1>td:1>a"
      },
      "risky": false
    },
    {
      "id": "s6",
      "intent": "Extract just the balance value",
      "timeoutMs": 10000,
      "action": "extract",
      "anchor": "Savings",
      "cellIndex": 1,
      "output": "savings_balance"
